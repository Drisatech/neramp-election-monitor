FROM python:3.12-slim

WORKDIR /app

# Install runtime libraries, Tesseract OCR, and build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    tesseract-ocr \
    tesseract-ocr-eng \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . /app/backend
RUN mkdir -p /app/data/uploads

ENV PYTHONUNBUFFERED=1

# Worker entrypoint for continuous queue ingestion and OCR processing
CMD ["python", "-m", "backend.app.ingestion.scheduler"]
