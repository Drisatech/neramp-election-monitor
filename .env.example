# ==============================================================================
# NIGERIA ELECTION WATCH - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# All values are non-secret placeholders. Copy to .env and provide real credentials
# through secure secret managers (e.g. Google Secret Manager, HashiCorp Vault).
# ==============================================================================

# Application Metadata
PROJECT_NAME="NIGERIA ELECTION WATCH"
PROJECT_SUBTITLE="Election Results Analysis and Monitoring Platform"
API_V1_STR="/api/v1"

# Environment Profile: 'development', 'testing', 'staging', or 'production'
ENVIRONMENT=development

# Data Source Mode: 'DEVELOPMENT', 'HISTORICAL', 'MANUAL_IMPORT', or 'OFFICIAL_SOURCE'
DATA_SOURCE_MODE=DEVELOPMENT
IS_DEMONSTRATION=true

# ==============================================================================
# Relational Database Configuration (PostgreSQL 16 + PostGIS)
# ==============================================================================
# Async driver for FastAPI (asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/election_watch
# Sync driver for Alembic migrations & background tasks (psycopg2)
SYNC_DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/election_watch
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ==============================================================================
# Distributed Caching & Job Coordination (Redis)
# ==============================================================================
REDIS_URL=redis://:devredispass@localhost:6379/0
CACHE_DEFAULT_TTL_SECONDS=300

# ==============================================================================
# Authentication & Cryptographic Security
# ==============================================================================
# Must be at least 32 characters in production. Generate via: openssl rand -hex 32
SECRET_KEY=replace-with-a-cryptographically-secure-32-byte-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Brute-Force Rate Limiting
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_GENERAL_PER_MINUTE=120

# Cookie & Session Security (Set COOKIE_SECURE=true over HTTPS in production)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ==============================================================================
# Google Cloud Storage & Cloud SQL Configuration
# ==============================================================================
GCS_BUCKET_NAME=neramp-election-evidence-0652072827
CLOUD_SQL_INSTANCE=neramp-db
UPLOAD_MAX_FILE_SIZE_BYTES=10485760
STORAGE_LOCAL_PATH=./data/uploads

# ==============================================================================
# Official INEC Results Portal Integration Parameters
# ==============================================================================
INEC_OFFICIAL_PORTAL_URL=https://inecelectionresults.ng
INEC_API_BASE_URL=https://api.inecelectionresults.ng/v1
INEC_API_KEY=
INEC_CLIENT_CERT_PATH=

# Ingestion Queue & Rate Limits
INGESTION_RATE_LIMIT_PER_MINUTE=60
INGESTION_REQUEST_TIMEOUT_SECONDS=30
INGESTION_MAX_RETRIES=3
INGESTION_BACKOFF_FACTOR=2.0

# OCR Engine Configuration
OCR_ENGINE=gemini
OCR_CONFIDENCE_THRESHOLD=85.0

# ==============================================================================
# Multimodal AI Vision OCR Providers (Optional for Custom Deployments)
# ==============================================================================
# You can set one or more of these environment variables, or enter them dynamically
# via the Admin Settings modal in Command Centre or Ingestion & Status.
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_AI_PROVIDER=gemini
